+                    onClose(); true
+                } else false
+            }
+    ) {
+        LiveText("Groups", size = 18.sp, weight = FontWeight.Bold, modifier = Modifier.padding(start = 14.dp, bottom = 10.dp))
+        LazyColumn(state = listState, modifier = Modifier.fillMaxSize()) {
